{
  "name": "book-fork",
  "version": "0.5.0",
  "private": true,
  "description": "Book Fork frontend asset pipeline (Tailwind CSS + daisyUI, HTMX, Alpine.js)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vendor": "node scripts/vendor-assets.mjs",
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/app.css --minify",
    "dev:css": "tailwindcss -i ./static/css/input.css -o ./static/css/app.css --watch",
    "build": "npm run vendor && npm run build:css"
  },
  "dependencies": {
    "alpinejs": "^3.17.4",
    "htmx.org": "^2.0.11"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.47",
    "tailwindcss": "^4.3.3"
  }
}
