# Book Fork example environment.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only infrastructure/secrets belong here. Business/translation configuration
# (languages, providers, models, prompts, pricing, limits) lives in PocketBase.

# --- application -----------------------------------------------------------
APP_ENV=development
APP_NAME=Book Fork
APP_BASE_URL=http://localhost:8000
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false

# --- logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# --- PocketBase ------------------------------------------------------------
POCKETBASE_URL=http://127.0.0.1:8090
# Optional service credential for trusted server-side admin operations.
POCKETBASE_SERVICE_CREDENTIAL=
POCKETBASE_USERS_COLLECTION=users

# --- sessions / cookies ----------------------------------------------------
SESSION_COOKIE_NAME=book_fork_session
SESSION_MAX_AGE_SECONDS=1209600
COOKIE_DOMAIN=
# Leave unset to derive from APP_ENV (true in production).
# COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- OAuth sign-in (Google / GitHub) ---------------------------------------
# Apply to PocketBase with: uv run python scripts/configure_auth.py
# Register this exact redirect URI at each provider:
#   <APP_BASE_URL>/auth/oauth2/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- secrets ---------------------------------------------------------------
# Encrypts stored provider API keys and the session cookie.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-random-encryption-key
WORKER_INTERNAL_TOKEN=replace-with-a-random-worker-token

# --- storage ---------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=var/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# --- document processing (safety ceilings, not product limits) --------------
DOCUMENT_TEMP_ROOT=var/tmp
DOCUMENT_MAX_UNCOMPRESSED_BYTES=524288000
DOCUMENT_MAX_ARCHIVE_ENTRIES=5000
DOCUMENT_MAX_COMPRESSION_RATIO=200
DOCUMENT_MAX_TEXT_BLOCKS=200000
DOCUMENT_MAX_PDF_PAGES=5000
# pymupdf (default book PDF: cover, contents, page numbers; no system libs)
# | html (reflow preview) | weasyprint (needs the 'pdf' extra + pango/cairo)
DOCUMENT_RENDER_BACKEND=pymupdf
# Formats produced per finished job.
DOCUMENT_OUTPUT_FORMATS=epub,pdf
# Book trim size for PDF output: a4 | a5 | b5 | letter | a6
DOCUMENT_BOOK_PAGE_SIZE=a5
# Optional directory of extra fonts (Family-Regular.ttf / Family-Bold.ttf) for
# scripts beyond the bundled Vazirmatn (Persian/Arabic) and Crimson Text (Latin).
DOCUMENT_FONT_DIR=
# none | (future) tesseract | paddleocr | cloud
OCR_PROVIDER=none

# --- web / transport security ----------------------------------------------
# Transport safety ceiling in bytes (NOT the product document size limit).
MAX_REQUEST_BYTES=104857600
# JSON array.
TRUSTED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=[]
ENABLE_DOCS=true

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_PROVIDER_TEST_PER_MINUTE=20
RATE_LIMIT_TRANSLATION_PER_MINUTE=30
RATE_LIMIT_RETRY_PER_MINUTE=30

# --- browser security headers ----------------------------------------------
SECURITY_HEADERS_ENABLED=true
# Optional override; leave empty to use the HTMX+Alpine-compatible default.
CONTENT_SECURITY_POLICY=

# --- reverse proxy / deployment --------------------------------------------
# Proxies whose X-Forwarded-* headers are trusted (uvicorn reads this too).
FORWARDED_ALLOW_IPS=127.0.0.1
# Set when the app is mounted under a sub-path behind a proxy.
ROOT_PATH=

